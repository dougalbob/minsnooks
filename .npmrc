engine-strict=true
# Work around npm arborist bug (#loadPeerSet) on this dependency graph
legacy-peer-deps=true
# E2B/Node-images ship headers at /usr/local/include/node; node-gyp must not
# try to download them from nodejs.org (egress is blocked → build fails).
# Remove this line if your Node lives elsewhere (e.g. nvm).
nodedir=/usr/local
