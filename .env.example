# Minsnooks V2 — example environment. Copy to .env for local dev; never commit .env.

# --- Authentication ---------------------------------------------------------
# 'dev'    local development identity only; NEVER works with NODE_ENV=production
# 'access' Cloudflare Access JWT verification + allowlist (fail closed)
AUTH_MODE=dev
DEV_USER_EMAIL=maya.chen@example.test

# Required when AUTH_MODE=access:
# CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_AUD=your-application-aud-tag
# ACCESS_EMAIL_ALLOWLIST=alice@example.com,bob@example.com

# --- Database ---------------------------------------------------------------
DATABASE_PATH=data/minsnooks.db

# --- Optional browser push (without these the in-app inbox still works) ------
# Generate a fresh VAPID key pair for the deployment; keep PRIVATE_KEY secret.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
